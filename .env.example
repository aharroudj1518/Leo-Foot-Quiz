# Public SDK keys only. Never put RevenueCat secret REST keys in EXPO_PUBLIC variables.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Enable only after store sandbox validation, privacy review and editorial sign-off.
EXPO_PUBLIC_COMMERCE_READY=false
# Optional: a public HTTPS URL serving validated editorial JSON (see docs/news-publishing.md).
# This is your own reviewed feed, never a news-provider API key. Requested only on an adult refresh action.
EXPO_PUBLIC_NEWS_FEED_URL=
# Optional: the real public app/store destination included in score shares.
EXPO_PUBLIC_APP_URL=
