{
  "name": "leoqo",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.9.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "phone": "expo start --go --lan",
    "test:coverage": "vitest run --coverage",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:web": "expo export --platform web",
    "check": "npm run typecheck && npm test && npm run test:offline && npm run content:check && npm run release:check",
    "test:offline": "node --test --test-isolation=none tests/*-offline.test.mjs",
    "content:check": "node scripts/validate-news.mjs",
    "release:check": "node scripts/check-release.mjs",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "eas-build-post-install": "node scripts/check-cloud-build.mjs"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
